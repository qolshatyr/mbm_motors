              "console.log(\"HTTP_STATUS:\" + pm.response.code);",
              "if (pm.response.code === 200) {",
              "  const rows = pm.response.json();",
              "  pm.test(\"Ответ — массив\", function () { pm.expect(rows).to.be.an(\"array\"); });",
              "  if (Array.isArray(rows)) {",
              "    console.log(\"COUNT:\" + rows.length);",
              "    pm.test(\"Каждая запись — объект с ID\", function () { rows.forEach(p => { pm.expect(p).to.be.an(\"object\"); pm.expect(p.id).to.be.a(\"string\").and.not.empty; }); });",
              "    const ids = rows.map(p => p.id);",
              "    console.log(\"DUPLICATE_IDS:\" + (ids.length - new Set(ids).size));",
              "    console.log(\"ITEM_SAMPLE:\" + JSON.stringify(rows.slice(0, 3).map(p => ({id:p.id, updated_at:p.updated_at, unit:p.unit, image_count:Array.isArray(p.img) ? p.img.length : null}))));",
              "    console.log(\"FIRST_RECORD_KEYS:\" + JSON.stringify(rows.length ? Object.keys(rows[0]) : []));",
              "  }",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
