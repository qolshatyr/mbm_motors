# Copy to deploy/production/.env on the server and fill in. Never commit the filled file.

# Site address. Without a domain use <server IP with dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
SITE_ADDRESS=

# Long random password for the production database.
DB_PASSWORD=

# CloudShop token. Catalog sync needs read access; order delivery needs write access.
CLOUDSHOP_TOKEN=
CATALOG_SYNC_ENABLED=false
# Turn on only after the controlled test sale approved by the owner.
MBM_DELIVERY_ENABLED=false

# Staff request view (/admin/requests). Hash: BCrypt, cost 10–16.
MBM_ADMIN_ENABLED=false
MBM_ADMIN_USERNAME=
MBM_ADMIN_PASSWORD_HASH=
# true: новый клиент сразу получает карточку покупателя CloudShop (нужен токен с правом записи).
MBM_ADMIN_CREATE_CUSTOMERS=false

# Off-server backups: rclone crypt remote and path, e.g. mbm-backup:mbm-motors. Empty = local only.
BACKUP_REMOTE=
# Days to keep copies on the remote (at least 7).
BACKUP_REMOTE_KEEP_DAYS=30
# true only if the remote is not crypt and the storage itself is trusted with partner data.
BACKUP_REMOTE_ALLOW_PLAIN=false
